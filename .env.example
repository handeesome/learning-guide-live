# Local setup generates a unique secret. Never put real secrets in this file.
DATABASE_URL=file:./dev.db
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# LiveKit Cloud project: Settings > API keys. Server-only; never use NEXT_PUBLIC_.
# URL format: wss://your-project.livekit.cloud (no trailing API path).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# DeepSeek summary generation. Server-only; the current low-cost default is
# deepseek-v4-flash. Leave the model blank to use that default.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
